# Anthropic Messages API key. Never commit the real one.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for generation and explanations.
# Haiku is the right default here: both calls are short and latency-sensitive.
# Switch to claude-sonnet-5 if hard questions on niche topics come back weak.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Per-attempt timeout in ms. The queue hides this from players, but an
# explanation that takes longer than this falls back to the static text.
AI_TIMEOUT_MS=12000

# Demo server only.
PORT=3100
